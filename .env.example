# Provider keys
GOOGLE_API_KEY=
VOYAGE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-mcp-docs-rag-playground
LANGSMITH_TRACING=true

# Postgres with pgvector (native WSL install)
DATABASE_URL=postgresql+psycopg://mcp_rag:mcp_rag@localhost:5432/mcp_rag

# Gemini models: a Flash-tier model for routing/grading, a Pro-tier model for answers.
# The -latest aliases move with each release; pin stable IDs before recording eval baselines.
ROUTER_MODEL=gemini-flash-latest
ANSWER_MODEL=gemini-pro-latest

# Voyage models
EMBED_MODEL=voyage-4
RERANK_MODEL=rerank-2.5

# Retrieval and graph thresholds
TOP_K=20
RERANK_TOP_N=6
RELEVANCE_THRESHOLD=2
MAX_REWRITES=2

# Source corpus and local cache (git-ignored)
MCP_REPO_URL=https://github.com/modelcontextprotocol/modelcontextprotocol
CACHE_DIR=.cache

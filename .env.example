# Provider keys: each integration reads its own variable
GOOGLE_API_KEY=
VOYAGE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-mcp-docs-rag-playground
LANGSMITH_TRACING=true

# Postgres with pgvector (native WSL install)
DATABASE_URL=postgresql+psycopg://mcp_rag:mcp_rag@localhost:5432/mcp_rag

# Models are provider:model. Gemini and Voyage are the examples used here; any LangChain
# integration works (e.g. anthropic:..., openai:..., ollama:...) once its package is added
# with `uv add langchain-<provider>` and its API key variable is set above.
# Chat: a fast model for routing/grading, a stronger one for answers. Pinned IDs keep eval
# runs comparable.
ROUTER_MODEL=google_genai:gemini-3.8-flash
ANSWER_MODEL=google_genai:gemini-3.8-flash

# Embeddings and reranking. Rerank providers: voyageai, cohere (see app/models.py).
# Changing EMBED_MODEL indexes into a new collection; EMBED_DIMENSIONS must match the model.
EMBED_MODEL=voyageai:voyage-4
EMBED_DIMENSIONS=1024
# Ingestion rate limits (0 = unlimited). Voyage without a payment method advertises
# 3 RPM / 10K TPM but rejected batches much over 1.5K tokens; these values got through.
EMBED_RPM=2
EMBED_TPM=3000
EMBED_BATCH_TOKENS=1500
RERANK_MODEL=voyageai:rerank-2.5

# Retrieval and graph thresholds
TOP_K=20
RERANK_TOP_N=6
RELEVANCE_THRESHOLD=2
MAX_REWRITES=2

# Chunking (characters)
CHUNK_SIZE=1500
CHUNK_OVERLAP=150

# Source corpus and local cache (git-ignored)
MCP_REPO_URL=https://github.com/modelcontextprotocol/modelcontextprotocol
CACHE_DIR=.cache

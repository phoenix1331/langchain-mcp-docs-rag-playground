# Provider keys
GOOGLE_API_KEY=
VOYAGE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-mcp-docs-rag-playground
LANGSMITH_TRACING=true

# Postgres with pgvector (native WSL install)
DATABASE_URL=postgresql+psycopg://mcp_rag:mcp_rag@localhost:5432/mcp_rag

# Gemini models: a Flash-tier model for routing/grading, a Pro-tier model for answers.
# Pinned IDs keep eval runs comparable. ANSWER_MODEL should be a Pro-tier model (e.g.
# gemini-3.1-pro-preview) once the key has billing enabled; free-tier keys have no Pro quota.
ROUTER_MODEL=gemini-3.8-flash
ANSWER_MODEL=gemini-3.8-flash

# Voyage models
EMBED_MODEL=voyage-4
EMBED_DIMENSIONS=1024
# Ingestion rate limits (0 = unlimited). Voyage without a payment method allows
# 3 RPM / 10K TPM; one below each leaves room for queries during an ingest.
EMBED_RPM=2
EMBED_TPM=9000
EMBED_BATCH_TOKENS=8000
RERANK_MODEL=rerank-2.5

# Retrieval and graph thresholds
TOP_K=20
RERANK_TOP_N=6
RELEVANCE_THRESHOLD=2
MAX_REWRITES=2

# Chunking (characters)
CHUNK_SIZE=1500
CHUNK_OVERLAP=150

# Source corpus and local cache (git-ignored)
MCP_REPO_URL=https://github.com/modelcontextprotocol/modelcontextprotocol
CACHE_DIR=.cache
